    ax = axes.ravel()[idx]
    ts, tr_sc, val_sc = learning_curve(lc_pipe, X_train, y_train, cv=cv3, train_sizes=train_sizes, scoring="f1_macro", n_jobs=-1)
    tr_m, tr_s = tr_sc.mean(axis=1), tr_sc.std(axis=1)
