    ax.plot(ts, va_m, "s-", color=PALETTE[2], label="CV Macro-F1")
    ax.fill_between(ts, va_m - va_s, va_m + va_s, alpha=0.15, color=PALETTE[2])
    ax.set_title(lbl)
    ax.set_xlabel("Training Set Size")
    ax.set_ylabel("Macro-F1")
    ax.set_ylim(0.86, 1.01)
    ax.legend(loc="lower right")
plt.suptitle("Learning Curves: Diagnosing Variance vs Bias Across Training Set Sizes", fontsize=14, fontweight="bold", y=1.01)
plt.tight_layout()
plt.show()

# 9.5 Explainable AI: Hold-Out Permutation Importance & SHAP TreeExplainer
perm_res = permutation_importance(winning_pipe, X_test, y_test, n_repeats=8, scoring="f1_macro", random_state=RANDOM_STATE, n_jobs=-1)
perm_df = pd.DataFrame({
    "Feature": num_features,
    "Perm_Importance_Mean": perm_res.importances_mean,
    "Perm_Importance_Std": perm_res.importances_std,
}).sort_values("Perm_Importance_Mean", ascending=False).reset_index(drop=True)

# SHAP on Tuned HistGradientBoostingClassifier (300 stratified test samples for crisp speed)
hgb_pipe = fitted_models["HistGB_Tuned"]
X_test_sc_df = pd.DataFrame(hgb_pipe.named_steps["prep"].transform(X_test), columns=num_features)
sample_idx = np.linspace(0, len(X_test_sc_df) - 1, 300, dtype=int)
X_shap = X_test_sc_df.iloc[sample_idx]
explainer = shap.TreeExplainer(hgb_pipe.named_steps["clf"])
shap_values = explainer.shap_values(X_shap)

# Global mean |SHAP| across all 7 classes
shap_arr = np.asarray(shap_values)
if shap_arr.ndim == 3:  # (n_samples, n_features, n_classes)
    mean_abs_shap = np.mean(np.abs(shap_arr), axis=(0, 2))
    per_class_shap = np.mean(np.abs(shap_arr), axis=0)  # (n_features, n_classes)
else:
    mean_abs_shap = np.mean(np.abs(shap_arr), axis=0)
    per_class_shap = None

shap_imp_df = pd.DataFrame({"Feature": num_features, "Mean_Abs_SHAP": mean_abs_shap}).sort_values("Mean_Abs_SHAP", ascending=False)

fig, axes = plt.subplots(1, 2, figsize=(15, 5.8))
p_plot = perm_df.sort_values("Perm_Importance_Mean", ascending=True)
axes[0].barh(p_plot["Feature"], p_plot["Perm_Importance_Mean"], xerr=p_plot["Perm_Importance_Std"], color=PALETTE[0], alpha=0.85)
axes[0].set_title(f"Hold-Out Permutation Importance ({winner_name})")
axes[0].set_xlabel("Drop in Macro-F1 When Feature Permuted")

s_plot = shap_imp_df.sort_values("Mean_Abs_SHAP", ascending=True)
axes[1].barh(s_plot["Feature"], s_plot["Mean_Abs_SHAP"], color=PALETTE[2], alpha=0.85)
axes[1].set_title("Global Mean |SHAP| Importance (HistGB_Tuned)")
axes[1].set_xlabel("Mean |SHAP Value| (Impact Across 7 Classes)")
plt.tight_layout()
plt.show()

if per_class_shap is not None:
    shap_cls_df = pd.DataFrame(per_class_shap, index=num_features, columns=class_names)
    fig, ax = plt.subplots(figsize=(10, 6))
    sns.heatmap(shap_cls_df, annot=True, fmt=".2f", cmap="magma_r", linewidths=0.4, ax=ax)
    ax.set_title("Per-Class Mean |SHAP| Matrix (Which Features Identify Each Variety)")
    plt.tight_layout()
    plt.show()

# 9.6 Serialize Winning Pipeline & Export Metrics Summary for Demo App & Viva Guide
sample_presets = {}
for cls_idx, cls_name in enumerate(class_names):
    row_idx = int(np.where(y_test == cls_idx)[0][0])
    sample_presets[cls_name] = {k: round(float(v), 6) for k, v in X_test.iloc[row_idx].to_dict().items()}

feature_bounds = {
